{
  "name": "dsh-skillcard",
  "version": "0.3.0",
  "description": "Skill cards for DeepSeek Harness: turn recurring prompts into fill-in cards, run them with a chosen workspace / preset / model, and get the answer back in the card. 技能卡片：把常用提示词变成填空卡片，填完直接执行并取回答案。",
  "license": "MIT",
  "author": "Thegongyx",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "cordis",
    "skill-cards",
    "prompt-template",
    "prompt-library",
    "agent",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thegongyx/dsh-skillcard.git"
  },
  "homepage": "https://github.com/Thegongyx/dsh-skillcard#readme",
  "bugs": {
    "url": "https://github.com/Thegongyx/dsh-skillcard/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}